---
// Rune of the Day (2026-10-07, user's pick from the site suggestions): the app's daily stone on the web. The day is
// the visitor's own, so the page is drawn in the browser: every rune's words are in the page as data, the script
// picks today's (src/daily.ts, the app's own draw) and the stone waits, blank, to be turned, as on the app's home.
import { getImage, Image } from "astro:assets";

import realmHome from "../assets/bg/realm-home.webp";
import blank from "../assets/daily/blank.webp";
import { CORRESPONDENCES, nameIn, STONES } from "../content/correspondences";
import { content, dailyPath, guideCopy, guidePath, lore, runes } from "../guide";
import { copy, type Lang } from "../i18n";
import Base from "../layouts/Base.astro";
import Ornament from "./Ornament.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import AppNudge from "./guide/AppNudge.astro";
import "../styles/guide.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].daily;
const g = guideCopy[lang];
const c = content[lang];
const locale = lang === "tr" ? "tr-TR" : "en";
// The app's home card carves the day's rune into the daily stone (scripts/carve.mjs, src/assets/daily/).
const stones = import.meta.glob<{ default: ImageMetadata }>("../assets/daily/*.webp", { eager: true });
const stoneUrl = async (file: string) =>
  (await getImage({ src: stones[`../assets/daily/${file}.webp`].default, width: 300, format: "webp" })).src;
// The correspondence stones' pictures, small (the app's "To go with today" line).
const gems = import.meta.glob<{ default: ImageMetadata }>("../assets/gems/*.webp", { eager: true });
const gemUrl = async (id: string) =>
  (await getImage({ src: gems[`../assets/gems/${id}.webp`].default, width: 96, format: "webp" })).src;
// The phone's screen is the app's real home screen; only its daily card is drawn live over it.
const screens = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*/home.webp", { eager: true });
const homeScreen = screens[`../assets/screens/${lang}/home.webp`].default;
const silent = t.silent.split("\n");

// Every rune as the page needs it; the script shows one.
const data = await Promise.all(
  runes.map(async (r) => {
    const text = c.runes[r.name];
    const caps = [text.literalMeaning, c.aettNames[String(r.aett) as "1" | "2" | "3"], c.elements[r.element]]
      .join(" · ")
      .toLocaleUpperCase(locale);
    const reading = (x: typeof text.upright) => ({ keywords: x.keywords, general: x.general });
    return {
      name: r.name,
      caps,
      first: text.upright.general.match(/^[^.!?]+[.!?]/)?.[0] ?? text.upright.general,
      firstRev: text.reversed ? (text.reversed.general.match(/^[^.!?]+[.!?]/)?.[0] ?? text.reversed.general) : null,
      stone: await stoneUrl(r.name.toLowerCase()),
      stoneRev: r.reversible ? await stoneUrl(`${r.name.toLowerCase()}-rev`) : null,
      upright: reading(text.upright),
      reversed: r.reversible && text.reversed ? reading(text.reversed) : null,
      question: lore[lang].runes[r.name]?.question ?? "",
      corr: CORRESPONDENCES[r.name]
        ? {
            stones: await Promise.all(
              CORRESPONDENCES[r.name].stones.map(async (s) => ({ name: nameIn(STONES[s], lang), src: await gemUrl(s) })),
            ),
            incense: nameIn(CORRESPONDENCES[r.name].incense[0], lang),
            scent: nameIn(CORRESPONDENCES[r.name].scents[0], lang),
          }
        : null,
      guide: guidePath[lang].rune(r.name),
    };
  }),
);
const alternates = { en: dailyPath.en, tr: dailyPath.tr };
const home = lang === "tr" ? "/tr/" : "/";
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} path={dailyPath[lang]} alternates={alternates}>
  <SiteHeader lang={lang} otherHref={alternates[lang === "tr" ? "en" : "tr"]} />
  <main class="guide daily" data-runes={JSON.stringify(data)} data-lang={locale} data-reversed={t.reversed} data-more={t.readMore}>
    <section class="g-hero daily-hero">
      <div class="g-hero-bg" aria-hidden="true">
        <Image src={realmHome} alt="" widths={[700, 1400]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="wrap g-hero-inner">
        <nav class="crumbs" aria-label={t.title}><a href={home}>AskRune</a></nav>
        <span class="kicker" id="daily-date">{t.kicker}</span>
        <h1>{t.title}</h1>
        <Ornament />
        <p class="g-sub">{t.support}</p>

        {/* User, 2026-10-07: "if today's rune came inside a phone, as if using the app". The phone holds the app's
            real home screen (src/assets/screens/), and its daily card is drawn over it, live, in the app's layout
            (Direction A: the stone left; kicker, name, keywords, a gold line, the first sentence, one button). */}
        <div class="phone daily-phone">
          <div class="app-screen">
            <Image class="app-shot" src={homeScreen} alt="" widths={[390, 780]} sizes="320px" loading="eager" />
            <div class:list={["app-card", lang]} id="app-card">
              <div class="flip" id="flip">
                <div class="flip-inner">
                  <Image class="flip-face back" src={blank} alt="" widths={[300]} sizes="120px" loading="eager" />
                  <img class="flip-face front" id="daily-stone" alt="" width="150" height="150" />
                </div>
              </div>
              <div class="app-copy">
                <span class="app-kicker">{t.kicker}</span>
                <span class="app-name" id="app-name">{silent.map((l) => <span>{l}</span>)}</span>
                <span class="app-keys" id="app-keys">{t.support}</span>
                <span class="app-line" aria-hidden="true"></span>
                <span class="app-first" id="app-first" hidden></span>
                <button type="button" class="app-btn" id="turn" aria-label={t.turnLabel}>{t.turn}</button>
                <a class="app-btn" id="app-read" href="#daily-reading" hidden>{t.read} ›</a>
              </div>
            </div>
          </div>
        </div>
        <noscript><p class="g-sub">{t.about}</p></noscript>
      </div>
    </section>

    <div class="wrap g-body narrow daily-body">
      <section class="g-card reading daily-reading" id="daily-reading" hidden aria-live="polite">
        <h2 class="daily-title" id="daily-name" lang="en"></h2>
        <p class="daily-caps" id="daily-caps" hidden></p>
        <ul class="chips" id="daily-keywords" aria-label={g.keywords}></ul>
        <h2 class="visually-hidden">{g.general}</h2>
        <p id="daily-general"></p>
        <div class="question">
          <span class="kicker">{g.lore.question.toLocaleUpperCase(locale)}</span>
          <p id="daily-question"></p>
        </div>
        {/* Stones, incense and scent for today's rune, as under the app's daily card (modern). */}
        <div class="daily-corr" id="daily-corr" hidden>
          <div class="daily-corr-stones" id="daily-corr-stones"></div>
          <div class="daily-corr-text">
            <span class="kicker">{t.corrKicker}</span>
            <b id="daily-corr-names"></b>
            <span class="daily-corr-meta">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 15V9M8 9c-2-1.5-2-3 0-4.5s2-3 0-4.5M5 9c-1.2-1-1.2-2 0-3M11 9c1.2-1 1.2-2 0-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span id="daily-corr-incense"></span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5C6 4.5 3.5 7.2 3.5 10a4.5 4.5 0 0 0 9 0C12.5 7.2 10 4.5 8 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span id="daily-corr-scent"></span>
            </span>
            <small>{g.corr.note}</small>
          </div>
        </div>
        <p class="daily-links"><a id="daily-guide" href={guidePath[lang].index}></a></p>
        <p class="daily-later">{t.later}</p>
      </section>
      <p class="g-sources">{t.about}</p>
      <AppNudge lang={lang} />
    </div>
  </main>
  <SiteFooter lang={lang} />
</Base>

<script>
  import { drawDailyRune, todayKey } from "../daily";

  interface DailyData {
    name: string;
    caps: string;
    first: string;
    firstRev: string | null;
    stone: string;
    stoneRev: string | null;
    upright: { keywords: string[]; general: string };
    reversed: { keywords: string[]; general: string } | null;
    question: string;
    corr: { stones: { name: string; src: string }[]; incense: string; scent: string } | null;
    guide: string;
  }

  const main = document.querySelector<HTMLElement>("main.daily");
  if (main) {
    const all = JSON.parse(main.dataset.runes ?? "[]") as DailyData[];
    const key = todayKey();
    const draw = drawDailyRune(key);
    const r = all.find((x) => x.name === draw.name)!;
    const reversed = draw.reversed && !!r.reversed;
    const reading = reversed ? r.reversed! : r.upright;
    const $ = (id: string) => document.getElementById(id)!;

    // The date leads the kicker, as on the app ("6 Ekim · GÜNÜN RUNE'Sİ").
    const date = new Date().toLocaleDateString(main.dataset.lang, { day: "numeric", month: "long" });
    $("daily-date").textContent = `${date.toLocaleUpperCase(main.dataset.lang)} · ${$("daily-date").textContent}`;
    ($("daily-stone") as HTMLImageElement).src = (reversed ? r.stoneRev : r.stone) ?? r.stone;

    const show = (animate: boolean) => {
      const flip = $("flip");
      if (!animate) flip.classList.add("instant");
      flip.classList.add("turned");
      // The card, as the app's once the stone is turned.
      $("app-name").textContent = r.name;
      $("app-name").setAttribute("lang", "en");
      $("app-keys").textContent = reading.keywords.join(" · ");
      $("app-first").textContent = (reversed ? r.firstRev : r.first) ?? r.first;
      $("app-first").hidden = false;
      $("turn").hidden = true;
      $("app-read").hidden = false;
      $("app-card").classList.add("turned");
      // And the whole reading under the phone.
      $("daily-name").textContent = r.name;
      const caps = $("daily-caps");
      caps.textContent = reversed ? `${r.caps} · ${main.dataset.reversed?.toLocaleUpperCase(main.dataset.lang)}` : r.caps;
      caps.hidden = false;
      $("daily-keywords").replaceChildren(
        ...reading.keywords.map((k) => Object.assign(document.createElement("li"), { textContent: k })),
      );
      $("daily-general").textContent = reading.general;
      $("daily-question").textContent = r.question;
      if (r.corr) {
        const box = $("daily-corr-stones");
        box.replaceChildren(
          ...r.corr.stones.map((s) => {
            const img = document.createElement("img");
            img.src = s.src;
            img.alt = "";
            img.width = 48;
            img.height = 48;
            return img;
          }),
        );
        $("daily-corr-names").textContent = r.corr.stones.map((s) => s.name).join(" · ");
        $("daily-corr-incense").textContent = r.corr.incense;
        $("daily-corr-scent").textContent = r.corr.scent;
        $("daily-corr").hidden = false;
      }
      const link = $("daily-guide") as HTMLAnchorElement;
      link.href = r.guide;
      link.textContent = `${(main.dataset.more ?? "").replace("{rune}", r.name)} →`;
      $("daily-reading").hidden = false;
    };

    // Turned once today, it stays turned on this browser until tomorrow.
    let turned = false;
    try {
      turned = localStorage.getItem("askrune.dailyTurned") === key;
    } catch {}
    if (turned) show(false);
    const turn = () => {
      if (turned) return;
      turned = true;
      try {
        localStorage.setItem("askrune.dailyTurned", key);
      } catch {}
      show(true);
    };
    $("turn").addEventListener("click", turn);
    // The stone itself turns too (user, 2026-10-08: visitors did not know where to tap).
    $("flip").addEventListener("click", turn);
  }
</script>
