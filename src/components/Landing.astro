---
import { getImage, Image } from "astro:assets";

import altarWide from "../assets/bg/altar-wide.webp";
import chronicle from "../assets/bg/chronicle.webp";
import goldenVale from "../assets/bg/golden-vale.webp";
import hall from "../assets/bg/hall.webp";
import onbShare from "../assets/bg/onb-share.webp";
import realmBirth from "../assets/bg/realm-birth.webp";
import realmCompat from "../assets/bg/realm-compat.webp";
import realmHome from "../assets/bg/realm-home.webp";
import realmReading from "../assets/bg/realm-reading.webp";
import realmTalisman from "../assets/bg/realm-talisman.webp";
import scrolls from "../assets/bg/scrolls.webp";
import emblem from "../assets/craft/emblem.webp";
import stoneAlgiz from "../assets/craft/stone-algiz.webp";
import stoneAnsuz from "../assets/craft/stone-ansuz.webp";
import stoneDagaz from "../assets/craft/stone-dagaz.webp";
import stoneFehu from "../assets/craft/stone-fehu.webp";
import stoneIngwaz from "../assets/craft/stone-ingwaz.webp";
import { guidePath } from "../guide";
import { copy, type Feature, type Lang } from "../i18n";
import Ornament from "./Ornament.astro";
import RuneRibbon from "./RuneRibbon.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];

// The app's own screens per language (src/assets/screens/{tr,en}/, see CLAUDE.md for how they are made).
const screens = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*/*.webp", { eager: true });
const screen = (key: string) => screens[`../assets/screens/${lang}/${key}.webp`].default;

// Each feature in the photograph of its own room in the app (the realms).
const realmPhoto: Record<Feature["key"], ImageMetadata> = {
  home: realmHome,
  "reading-drawn": realmReading,
  birth: realmBirth,
  "talisman-medallion": realmTalisman,
  compat: realmCompat,
};
const realmFocus: Record<Feature["key"], string> = {
  home: "50% 30%",
  "reading-drawn": "50% 18%",
  birth: "50% 25%",
  "talisman-medallion": "50% 40%",
  compat: "50% 10%",
};

// A photograph for each "more" card: the scrolls (the guide), the chronicle (history and notes), a shared
// card (the onboarding's), the candle-lit room (the app in two languages).
const morePhotos = [scrolls, chronicle, onbShare, realmHome];
// Where each photograph's subject sits, so the card shows it above the words: the scroll, the book and
// hourglass, the Berkano card, the candle and the window (the room's top left is only shadow).
const moreFocus = ["50% 20%", "50% 25%", "50% 30%", "62% 55%"];
// The carved stones (scripts/carve.mjs: the app's own glyphs cut into the app's own stones).
const craftStones = [
  { src: stoneFehu, alt: "Fehu" },
  { src: stoneAnsuz, alt: "Ansuz" },
  { src: stoneAlgiz, alt: "Algiz" },
];

// Hero: the candle-lit hall (portrait) on phones, the altar (wide) on large screens.
const heroWide = await getImage({ src: altarWide, width: 2000, format: "webp" });
---

<SiteHeader lang={lang} otherHref={t.nav.otherHref} home />

<main>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <picture>
        <source media="(min-width: 960px)" srcset={heroWide.src} />
        <Image src={hall} alt="" widths={[600, 1000]} sizes="100vw" loading="eager" fetchpriority="high" />
      </picture>
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <span class="kicker">{t.hero.kicker}</span>
        <h1><span>{t.hero.title[0]}</span><span>{t.hero.title[1]}</span></h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <div class="stores">
          <div class="store">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="6" y="2.5" width="12" height="19" rx="2.6" stroke="#C8A46A" stroke-width="1.3"></rect>
              <path d="M10.5 18.5h3" stroke="#C8A46A" stroke-width="1.3" stroke-linecap="round"></path>
            </svg>
            <span><small>{t.hero.soon.toLocaleUpperCase(lang)}</small><b>{t.hero.ios}</b></span>
          </div>
          <div class="store">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 3.5v17l13-8.5z" stroke="#C8A46A" stroke-width="1.3" stroke-linejoin="round"></path>
            </svg>
            <span><small>{t.hero.soon.toLocaleUpperCase(lang)}</small><b>{t.hero.android}</b></span>
          </div>
        </div>
      </div>
      {/* The home screen, and beside it the day's stone carved as it is in the app (Dagaz, as on the screen). */}
      <div class="hero-phone">
        <div class="phone front">
          <Image src={screen("home")} alt={t.features[0].alt} widths={[390, 600, 780]} sizes="270px" loading="eager" />
        </div>
        <Image class="hero-stone" src={stoneDagaz} alt="Dagaz" widths={[240, 400]} sizes="200px" loading="eager" />
      </div>
    </div>
  </section>

  <div class="ribbon-band wrap"><RuneRibbon /></div>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="head">
        <span class="kicker">{t.head.features.kicker}</span>
        <h2 id="features-title">{t.head.features.title}</h2>
        <Ornament />
        <p>{t.head.features.text}</p>
      </div>
      <div class="realms">
        {
          t.features.map((f, i) => (
            <article class:list={["realm", { flip: i % 2 === 1 }]}>
              <div class="realm-bg" aria-hidden="true">
                <Image src={realmPhoto[f.key]} alt="" widths={[700, 1200]} sizes="(min-width: 960px) 1160px, 100vw" style={`object-position:${realmFocus[f.key]}`} />
              </div>
              <div class="realm-copy">
                <span class="kicker">{f.kicker.toLocaleUpperCase(lang)}</span>
                <h3>{f.title}</h3>
                <div class="line" />
                <p>{f.text}</p>
              </div>
              {f.key === "home" ? (
                // The home screen leads the page; here the day's stone itself, carved.
                <div class="realm-stone">
                  <Image src={stoneIngwaz} alt="Ingwaz" widths={[200, 360]} sizes="170px" />
                </div>
              ) : (
                <div class="phone">
                  <Image src={screen(f.key)} alt={f.alt} widths={[390, 600, 780]} sizes="270px" />
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tight" aria-labelledby="more-title">
    <div class="wrap">
      <div class="head">
        <span class="kicker">{t.head.more}</span>
        <h2 id="more-title">{t.more.title}</h2>
        <Ornament />
      </div>
      <div class="grid4">
        {
          t.more.items.map((m, i) => (
            <div class:list={["tile", { linked: i === 0 }]}>
              <div class="tile-photo">
                <Image
                  src={morePhotos[i]}
                  alt=""
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 960px) 280px, (min-width: 720px) 50vw, 100vw"
                  style={`object-position:${moreFocus[i]}`}
                />
              </div>
              <div class="tile-copy">
                <span class="tile-line" aria-hidden="true" />
                <h3>{i === 0 ? <a href={guidePath[lang].index}>{m.title}</a> : m.title}</h3>
                <p>{m.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="craft" aria-labelledby="craft-title">
    <div class="band-bg" aria-hidden="true">
      <Image src={goldenVale} alt="" widths={[800, 1400]} sizes="100vw" />
    </div>
    <div class="wrap craft-grid">
      <div class="craft-copy">
        <span class="kicker">{t.craft.kicker}</span>
        <h2 id="craft-title">{t.craft.title}</h2>
        <div class="line"></div>
        <p>{t.craft.text}</p>
        <p class="note">{t.craft.note}</p>
      </div>
      <div class="craft-stones">
        {craftStones.map((s) => <Image src={s.src} alt={s.alt} widths={[240, 420]} sizes="(min-width: 960px) 200px, 30vw" />)}
      </div>
    </div>
  </section>

  <section class="section tight" aria-labelledby="privacy-title">
    <div class="wrap">
      <div class="head">
        <span class="kicker">{t.head.privacy}</span>
        <h2 id="privacy-title">{t.privacy.title}</h2>
        <Ornament />
      </div>
      <ul class="vows">
        {
          t.privacy.items.map((i) => (
            <li>
              <i aria-hidden="true" />
              <b>{i.title}</b>
              <span>{i.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="center-link"><a href={t.legal.privacy}>{t.privacy.link}</a></p>
    </div>
  </section>

  <section class="section tight plans-sec" aria-labelledby="plans-title">
    <div class="plans-bg" aria-hidden="true"><Image src={hall} alt="" widths={[800, 1000]} sizes="100vw" /></div>
    <div class="wrap">
      <div class="head">
        <span class="kicker">{t.head.plans}</span>
        <h2 id="plans-title">{t.plans.title}</h2>
        <Ornament />
      </div>
      <div class="plans">
        <div class="plan">
          <span class="kicker">{t.plans.free.toLocaleUpperCase(lang)}</span>
          <h3>{t.plans.free}</h3>
          <ul>{t.plans.freeItems.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="plan gold">
          <Image class="plan-emblem" src={emblem} alt="" widths={[160, 240]} sizes="96px" />
          <span class="kicker">PREMIUM</span>
          <h3>{t.plans.premium}</h3>
          <ul>{t.plans.premiumItems.map((i) => <li>{i}</li>)}</ul>
          <p class="plan-note">{t.plans.note}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="head">
        <span class="kicker">{t.head.faq}</span>
        <h2 id="faq-title">{t.faq.title}</h2>
        <Ornament />
      </div>
      {
        t.faq.groups.map((g) => (
          <div class="faq">
            <h3 class="faq-group">{g.title.toLocaleUpperCase(lang)}</h3>
            {g.items.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>
                  {f.a}
                  {f.link && (
                    <a class="faq-link" href={guidePath[lang][f.link.page]}>
                      {f.link.label}
                    </a>
                  )}
                </p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</main>

<SiteFooter lang={lang} />
