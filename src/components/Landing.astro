---
import { Image } from "astro:assets";

import altar from "../assets/bg/altar-wide.webp";
import forest from "../assets/bg/forest-wide.webp";
import { copy, type Lang } from "../i18n";
import Wordmark from "./Wordmark.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];

// The app's own screens per language (src/assets/screens/{tr,en}/, see CLAUDE.md for how they are made).
const screens = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*/*.webp", { eager: true });
const screen = (key: string) => screens[`../assets/screens/${lang}/${key}.webp`].default;
const otherLang = lang === "tr" ? "en" : "tr";
---

<header class="top">
  <div class="wrap">
    <Wordmark width={128} />
    <a class="lang" href={t.nav.otherHref} hreflang={otherLang} lang={otherLang} data-lang={otherLang}>{t.nav.other}</a>
  </div>
</header>

<main>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <Image src={altar} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <h1><span>{t.hero.title[0]}</span><span>{t.hero.title[1]}</span></h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <div class="stores">
          <div class="store">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="6" y="2.5" width="12" height="19" rx="2.6" stroke="#C8A46A" stroke-width="1.4"></rect>
              <path d="M10.5 18.5h3" stroke="#C8A46A" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            <span><small>{t.hero.soon}</small><b>{t.hero.ios}</b></span>
          </div>
          <div class="store">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 3.5v17l13-8.5z" stroke="#C8A46A" stroke-width="1.4" stroke-linejoin="round"></path>
            </svg>
            <span><small>{t.hero.soon}</small><b>{t.hero.android}</b></span>
          </div>
        </div>
      </div>
      <div class="hero-phone">
        <div class="phone">
          <Image src={screen("home")} alt={t.features[0].alt} widths={[390, 600, 780]} sizes="300px" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <h2 class="sr-only" id="features-title">{t.meta.title}</h2>
      <div class="features">
        {
          t.features.slice(1).map((f) => (
            <article class="feature">
              <div class="feature-copy">
                <span class="kicker">{f.kicker.toLocaleUpperCase(lang)}</span>
                <h2>{f.title}</h2>
                <div class="rule" />
                <p>{f.text}</p>
              </div>
              <div class="phone">
                <Image src={screen(f.key)} alt={f.alt} widths={[390, 600, 780]} sizes="300px" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <h2 class="section-title" id="more-title">{t.more.title}</h2>
      <div class="grid4">
        {
          t.more.items.map((m) => (
            <div class="card">
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="craft-title">
    <div class="band-bg" aria-hidden="true">
      <Image src={forest} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
    </div>
    <div class="wrap">
      <h2 id="craft-title">{t.craft.title}</h2>
      <div class="rule"></div>
      <p>{t.craft.text}</p>
      <p class="note">{t.craft.note}</p>
    </div>
  </section>

  <section class="section center" aria-labelledby="privacy-title">
    <div class="wrap">
      <h2 class="section-title" id="privacy-title">{t.privacy.title}</h2>
      <ul class="pills">
        {t.privacy.items.map((i) => <li>{i}</li>)}
      </ul>
      <a href={t.legal.privacy}>{t.privacy.link}</a>
    </div>
  </section>

  <section class="section" aria-labelledby="plans-title">
    <div class="wrap">
      <h2 class="section-title" id="plans-title">{t.plans.title}</h2>
      <div class="plans">
        <div class="plan">
          <h3>{t.plans.free}</h3>
          <ul>{t.plans.freeItems.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="plan gold">
          <h3>{t.plans.premium}</h3>
          <ul>{t.plans.premiumItems.map((i) => <li>{i}</li>)}</ul>
          <p class="plan-note">{t.plans.note}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 class="section-title" id="faq-title">{t.faq.title}</h2>
      <div class="faq">
        {
          t.faq.items.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    <Wordmark width={112} />
    <nav aria-label={t.footer.contact}>
      <a href={t.legal.privacy}>{t.footer.privacy}</a>
      <a href={t.legal.terms}>{t.footer.terms}</a>
      <a href={t.legal.support}>{t.footer.support}</a>
      <a href="mailto:destek@askrune.app">destek@askrune.app</a>
    </nav>
    <small>{t.footer.rights}</small>
  </div>
</footer>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
